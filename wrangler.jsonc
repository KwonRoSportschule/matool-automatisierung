{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matool-middleware-hub",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Request-Logs enthielten die volle URL samt Suchbegriffen, also Namen.
    // Die eigenen strukturierten Logs bleiben und sind frei von Personendaten.
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "APP_ENV": "local",
    "ACCESS_AUD": "configure-with-cloudflare-access",
    "ACCESS_SERVICE_AUD": "configure-with-cloudflare-access-service-app",
    "ACCESS_TEAM_DOMAIN": "configure-with-cloudflare-access",
    "MATOOL_BASE_URL": "https://core.matool.de",
    "OUTBOUND_DELIVERY_ENABLED": "false",
    "DASHBOARD_PASSWORD_REQUIRED": "false",
    "DASHBOARD_REQUIRE_CLOUDFLARE_ACCESS": "false",
    "DATA_ENCRYPTION_REQUIRED": "false",
    "PUBLIC_DASHBOARD_FULL_ACCESS": "false",
    "PUBLIC_DASHBOARD_READ_ONLY": "false",
    "PUBLIC_DASHBOARD_PLAINTEXT": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matool-middleware-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "binding": "INTERESSENTEN_SYNC_WORKFLOW",
      "name": "matool-interessenten-sync-local",
      "class_name": "InteressentenSyncWorkflow"
    }
  ],
  "env": {
    "staging": {
      "name": "matool-middleware-staging",
      "workers_dev": true,
      "preview_urls": false,
      "version_metadata": {
        "binding": "VERSION_METADATA"
      },
      "vars": {
        "APP_ENV": "staging",
        "ACCESS_AUD": "da7897b053c6af64c05371801a7f7081bf394937a0c657c1d5fd88260bba46ca",
        "ACCESS_SERVICE_AUD": "configure-with-cloudflare-access-service-app",
        "ACCESS_TEAM_DOMAIN": "soft-hill-4630.cloudflareaccess.com",
        "MATOOL_BASE_URL": "https://core.matool.de",
        // Live-Zustellung an Zapier, freigegeben am 25.09.2026. Aenderungen vor
        // dem Startzeitpunkt werden nie verschickt, damit kein Rueckstau alte
        // Zaps ausloest.
        "OUTBOUND_DELIVERY_ENABLED": "true",
        "OUTBOUND_DELIVERY_START_AT": "2026-09-25T15:02:00Z",
        // Webseite und Admin-API nur mit Benutzername und Passwort. Beides
        // liegt ausschliesslich als Cloudflare Secret vor:
        //   wrangler secret put DASHBOARD_USERNAME --env staging
        //   wrangler secret put DASHBOARD_PASSWORD --env staging
        // Solange die Secrets fehlen, bleibt das Dashboard gesperrt.
        "DASHBOARD_PASSWORD_REQUIRED": "true",
        // Zweiter Faktor: erst auf "true", wenn Cloudflare Access die
        // workers.dev-Adresse schuetzt (siehe SECURITY.md).
        "DASHBOARD_REQUIRE_CLOUDFLARE_ACCESS": "false",
        // Personendaten nur verschluesselt speichern. Schluessel als Secret:
        //   wrangler secret put DATA_ENCRYPTION_KEY --env staging
        // Ohne Schluessel schlagen Syncs fehl, statt Klartext zu speichern.
        "DATA_ENCRYPTION_REQUIRED": "true",
        "PUBLIC_DASHBOARD_FULL_ACCESS": "false",
        "PUBLIC_DASHBOARD_READ_ONLY": "false",
        // Klartext nur noch hinter dem Passwortschutz sichtbar.
        "PUBLIC_DASHBOARD_PLAINTEXT": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "matool-middleware-staging",
          "database_id": "4e002f53-31da-4212-bb46-c38ce05a36e2",
          "migrations_dir": "migrations"
        }
      ],
      "workflows": [
        {
          "binding": "INTERESSENTEN_SYNC_WORKFLOW",
          "name": "matool-interessenten-sync-staging",
          "class_name": "InteressentenSyncWorkflow"
        }
      ],
      // Spiegelt die im Cloudflare-Dashboard gesetzten Limits (Workers Paid).
      // Ohne diesen Block gilt die Vorgabe von 30 Sekunden CPU: Ein Deploy
      // wuerde die Dashboard-Werte entfernen, der Listenschritt ueber mehrere
      // tausend Interessenten bricht dann mit "exceededCpu" ab und wiederholt
      // sich endlos (am 25.08.2026 an einem haengenden Workflow belegt).
      "limits": {
        "cpu_ms": 300000,
        "subrequests": 10000
      },
      "triggers": {
        "crons": ["0 7-18 * * mon-fri"]
      }
    },
    "production": {
      "name": "matool-middleware-production",
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": {
        "binding": "VERSION_METADATA"
      },
      "limits": {
        "cpu_ms": 300000,
        "subrequests": 10000
      },
      "vars": {
        "APP_ENV": "production",
        "ACCESS_AUD": "configure-with-cloudflare-access",
        "ACCESS_SERVICE_AUD": "configure-with-cloudflare-access-service-app",
        "ACCESS_TEAM_DOMAIN": "configure-with-cloudflare-access",
        "MATOOL_BASE_URL": "https://core.matool.de",
        "OUTBOUND_DELIVERY_ENABLED": "false",
        "DASHBOARD_PASSWORD_REQUIRED": "false",
        "DASHBOARD_REQUIRE_CLOUDFLARE_ACCESS": "false",
        "DATA_ENCRYPTION_REQUIRED": "true",
        "PUBLIC_DASHBOARD_FULL_ACCESS": "false",
        "PUBLIC_DASHBOARD_READ_ONLY": "false",
        "PUBLIC_DASHBOARD_PLAINTEXT": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "matool-middleware-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "workflows": [
        {
          "binding": "INTERESSENTEN_SYNC_WORKFLOW",
          "name": "matool-interessenten-sync-production",
          "class_name": "InteressentenSyncWorkflow"
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  }
}
