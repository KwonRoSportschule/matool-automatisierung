{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matool-middleware-hub",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ENV": "local",
    "ACCESS_AUD": "configure-with-cloudflare-access",
    "ACCESS_SERVICE_AUD": "configure-with-cloudflare-access-service-app",
    "ACCESS_TEAM_DOMAIN": "configure-with-cloudflare-access",
    "MATOOL_BASE_URL": "https://core.matool.de",
    "OUTBOUND_DELIVERY_ENABLED": "false",
    "PUBLIC_DASHBOARD_FULL_ACCESS": "false",
    "PUBLIC_DASHBOARD_READ_ONLY": "false",
    "PUBLIC_DASHBOARD_PLAINTEXT": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matool-middleware-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "matool-middleware-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "ACCESS_AUD": "da7897b053c6af64c05371801a7f7081bf394937a0c657c1d5fd88260bba46ca",
        "ACCESS_SERVICE_AUD": "configure-with-cloudflare-access-service-app",
        "ACCESS_TEAM_DOMAIN": "soft-hill-4630.cloudflareaccess.com",
        "MATOOL_BASE_URL": "https://core.matool.de",
        "OUTBOUND_DELIVERY_ENABLED": "false",
        "PUBLIC_DASHBOARD_FULL_ACCESS": "true",
        "PUBLIC_DASHBOARD_READ_ONLY": "true",
        "PUBLIC_DASHBOARD_PLAINTEXT": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "matool-middleware-staging",
          "database_id": "4e002f53-31da-4212-bb46-c38ce05a36e2",
          "migrations_dir": "migrations"
        }
      ],
      // Hinweis: "limits": { "cpu_ms": ... } benoetigt Workers Paid.
      // Auf dem Free-Tarif bricht ein Lauf nach etwa fuenf Bereichen mit
      // "exceededCpu" ab.
      "triggers": {
        "crons": ["0 7-18 * * mon-fri"]
      }
    },
    "production": {
      "name": "matool-middleware-production",
      "workers_dev": false,
      "preview_urls": false,
      "limits": {
        "cpu_ms": 300000,
        "subrequests": 10000
      },
      "vars": {
        "APP_ENV": "production",
        "ACCESS_AUD": "configure-with-cloudflare-access",
        "ACCESS_SERVICE_AUD": "configure-with-cloudflare-access-service-app",
        "ACCESS_TEAM_DOMAIN": "configure-with-cloudflare-access",
        "MATOOL_BASE_URL": "https://core.matool.de",
        "OUTBOUND_DELIVERY_ENABLED": "false",
        "PUBLIC_DASHBOARD_FULL_ACCESS": "false",
        "PUBLIC_DASHBOARD_READ_ONLY": "false",
        "PUBLIC_DASHBOARD_PLAINTEXT": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "matool-middleware-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  }
}
